{
  "manifest_version": 3,
  "name": "Video Speed Controls",
  "version": "0.7.5",
  "description": "HTML5 video and audio speed controller with breathe mode; source-compatible with working FireMonkey userscript.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ff-vid-speed@mikewillems.com",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.aol.com/*",
        "*://*.archive.org/*",
        "*://*.baidu.com/*",
        "*://*.bilibili.com/*",
        "*://*.bing.com/*",
        "*://*.bouncetv.com/*",
        "*://*.brave.com/*",
        "*://*.coccoc.com/*",
        "*://*.coursera.org/*",
        "*://*.crunchyroll.com/*",
        "*://*.dailymotion.com/*",
        "*://*.dtube.video/*",
        "*://*.duckduckgo.com/*",
        "*://*.ecosia.org/*",
        "*://*.facebook.com/*",
        "*://*.filmrise.com/*",
        "*://*.google.com/*",
        "*://*.hulu.com/*",
        "*://*.instagram.com/*",
        "*://*.kanopy.com/*",
        "*://*.khanacademy.org/*",
        "*://*.linkedin.com/*",
        "*://*.liveleak.com/*",
        "*://*.metacafe.com/*",
        "*://*.mojeek.com/*",
        "*://*.msn.com/*",
        "*://*.naver.com/*",
        "*://*.netflix.com/*",
        "*://*.npr.org/*",
        "*://*.odysee.com/*",
        "*://*.peacocktv.com/*",
        "*://*.perplexity.ai/*",
        "*://*.plex.tv/*",
        "*://*.pluto.tv/*",
        "*://*.primevideo.com/*",
        "*://*.qwant.com/*",
        "*://*.reddit.com/*",
        "*://*.rumble.com/*",
        "*://*.seznam.cz/*",
        "*://*.m.sm.cn/*",
        "*://*.m.so.com/*",
        "*://*.sogou.com/*",
        "*://*.startpage.com/*",
        "*://*.ted.com/*",
        "*://*.therokuchannel.roku.com/*",
        "*://*.tiktok.com/*",
        "*://*.tubitv.com/*",
        "*://*.twitch.tv/*",
        "*://*.twitter.com/*",
        "*://*.udemy.com/*",
        "*://*.veoh.com/*",
        "*://*.vidyard.com/*",
        "*://*.viki.com/*",
        "*://*.vimeo.com/*",
        "*://*.vudu.com/*",
        "*://*.wikihow.com/*",
        "*://*.wistia.com/*",
        "*://*.x.com/*",
        "*://*.xumo.tv/*",
        "*://*.yahoo.com/*",
        "*://*.yandex.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["controller.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
